# Django
# En producción es obligatoria. En desarrollo, si queda vacía se usa una de desarrollo.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
# En desarrollo se permite el Host de WSL/Windows cuando DEBUG=1.
# En producción definí explícitamente tus dominios.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver

# PostgreSQL. If omitted, local development uses SQLite.
# En producción es obligatoria.
# DATABASE_URL=postgres://usuario:clave@localhost:5432/elaris

# Dominios confiables para formularios en producción.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://elaris.example.com

# Vercel + Neon (producción).
# Neon inyecta DATABASE_URL desde el Marketplace. En Vercel el filesystem
# es de solo lectura, así que no se puede usar SQLite en producción.
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=elaris-six-bice.vercel.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://elaris-six-bice.vercel.app

# Por defecto, en producción redirige a HTTPS.
# DJANGO_SECURE_SSL_REDIRECT=1

# Email transaccional (recuperación de contraseña).
# En desarrollo, si no configurás un host, el email se imprime en consola.
# Brevo: smtp-relay.brevo.com, puerto 587, usuario y clave SMTP.
# Resend: smtp.resend.com, puerto 587, usuario "resend", clave = API key.
# DJANGO_EMAIL_HOST=
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=1
# DJANGO_EMAIL_USE_SSL=0
# DEFAULT_FROM_EMAIL=Elaris <tu@email.com>
# DJANGO_PASSWORD_RESET_TIMEOUT=86400
