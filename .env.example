# Django
# En producción es obligatoria. En desarrollo, si queda vacía se usa una de desarrollo.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
# En desarrollo se permite el Host de WSL/Windows cuando DEBUG=1.
# En producción definí explícitamente tus dominios.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver

# PostgreSQL. If omitted, local development uses SQLite.
# En producción es obligatoria.
# DATABASE_URL=postgres://usuario:clave@localhost:5432/elaris

# Dominios confiables para formularios en producción.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://elaris.example.com

# Por defecto, en producción redirige a HTTPS.
# DJANGO_SECURE_SSL_REDIRECT=1

# Email (opcional por ahora; en desarrollo imprime en consola).
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=Elaris <hola@elaris.app>
